<!-- Chatbot JavaScript -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const chatbotToggle = document.getElementById("chatbot-toggle");
    const chatbotWindow = document.getElementById("chatbot-window");
    const chatbotMinimize = document.getElementById("chatbot-minimize");
    const chatbotClear = document.getElementById("chatbot-clear");
    const chatInput = document.getElementById("chat-input");
    const chatSend = document.getElementById("chat-send");
    const chatMessages = document.querySelector(".chat-container");
    const typingIndicator = document.getElementById("typing-indicator");

    // Gemini API configuration
    const GEMINI_API_KEY = '{{ APP.API_GEMINI_KEY ?? "" }}';
    const GEMINI_API_URL =
      "https://generativelanguage.googleapis.com/v1/models/gemini-2.5-flash:generateContent";

    let isOpen = false;
    let conversationHistory = [];

    // Define welcome message text to avoid editor formatting issues
    const welcomeText =
      "¡Hola! Soy Betito, tu asistente especializado en análisis de BETA para WACC. Puedo ayudarte a: • Analizar tu beta actual basado en los datos del formulario • Recomendar 10-20 empresas comparables del sector • Calcular un nuevo beta optimizado • Actualizar automáticamente tu formulario ¿Quieres que analice tus datos actuales?";

    // Welcome message will be formatted after formatAPIResponse function is defined

    // Toggle chatbot window
    chatbotToggle.addEventListener("click", function () {
      isOpen = !isOpen;
      if (isOpen) {
        chatbotWindow.style.display = "block";
        chatInput.focus();
      } else {
        chatbotWindow.style.display = "none";
      }
    });

    // Minimize chatbot
    chatbotMinimize.addEventListener("click", function () {
      isOpen = false;
      chatbotWindow.style.display = "none";
    });

    // Clear conversation
    chatbotClear.addEventListener("click", function () {
      clearConversationHistory();
    });

    function clearConversationHistory() {
      conversationHistory = [];
      const messages = chatMessages.querySelectorAll(
        ".message:not(:first-child)"
      );
      messages.forEach((message) => message.remove());

      const clearBtn = document.getElementById("chatbot-clear");
      clearBtn.innerHTML = '<i class="fas fa-check text-white"></i>';
      setTimeout(() => {
        clearBtn.innerHTML = '<i class="fas fa-refresh text-white"></i>';
      }, 1000);
    }

    // Send message on button click
    chatSend.addEventListener("click", sendMessage);

    // Send message on Enter key
    chatInput.addEventListener("keypress", function (e) {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    function setLoadingState(isLoading) {
      chatSend.disabled = isLoading;
      chatInput.disabled = isLoading;

      if (isLoading) {
        chatSend.innerHTML = '<i class="fas fa-spinner fa-spin p-0 m-0"></i>';
      } else {
        chatSend.innerHTML = '<i class="fas fa-paper-plane p-0 m-0"></i>';
      }
    }

    function formatAPIResponse(text) {
      if (!text) return "";

      return (
        text
          // Remove markdown formatting
          .replace(/\*\*(.*?)\*\*/g, "$1") // Remove bold **text**
          .replace(/\*(.*?)\*/g, "$1") // Remove italic *text*
          .replace(/`(.*?)`/g, "$1") // Remove code `text`

          // Remove all bullet points and numbered lists
          .replace(/^\s*\d+\.\s+\*\*(.*?)\*\*:\s*/gm, "$1: ") // "1. **Title**: " -> "Title: "
          .replace(/^\s*\d+\.\s+/gm, "") // Remove "1. " numbering
          .replace(/^\s*[-•]\s+/gm, "") // Remove "- " and "• " bullets
          .replace(/^\s*\*\s+/gm, "") // Remove "* " bullets

          // Clean up spacing - use single line breaks instead of bullets
          .replace(/\n{3,}/g, "\n\n") // Multiple line breaks -> double line break
          .replace(/^\s+|\s+$/g, "") // Trim whitespace

          // Clean up colons and improve readability
          .replace(/:\s*\n\n/g, ":\n") // "Title:\n\n" -> "Title:\n"
          .replace(/\n\n([A-Z])/g, "\n\n$1") // Add spacing before capital letters (new sections)
      );
    }

    function formatWelcomeMessage(text) {
      if (!text) return "";

      return (
        text
          // Remove bullets and clean up
          .replace(/•\s+/g, "") // Remove bullet points
          .replace(/:\s+/g, ":\n") // Add line breaks after colons
          .replace(/formulario\s+/g, "formulario\n") // Line break after formulario
          .replace(/sector\s+/g, "sector\n") // Line break after sector
          .replace(/optimizado\s+/g, "optimizado\n") // Line break after optimizado
          .replace(/formulario\s+¿/g, "formulario\n\n¿") // Double line break before question
          .trim()
      );
    }

    // Initialize welcome message now that formatWelcomeMessage is defined
    const welcomeMessage = document.getElementById("welcome-message");
    if (welcomeMessage) {
      const formattedText = formatWelcomeMessage(welcomeText);
      welcomeMessage.textContent = formattedText;
    }

    function sendMessage() {
      const message = chatInput.value.trim();
      if (message === "") return;

      setLoadingState(true);
      addMessage(message, "user");
      chatInput.value = "";
      showTypingIndicator();
      callGeminiAPI(message);
    }

    function addMessage(text, sender) {
      const messageDiv = document.createElement("div");
      messageDiv.className = `message ${sender}-message`;

      const currentTime = new Date().toLocaleTimeString("es-ES", {
        hour: "2-digit",
        minute: "2-digit",
      });

      messageDiv.innerHTML = `
            <div class="message-avatar ${sender === "user" ? "bg-secondary" : "bg-primary"}">
                <i class="fas ${sender === "user" ? "fa-user" : "fa-robot"} text-white"></i>
            </div>
            <div class="message-content">
                <div class="message-bubble">${text}</div>
                <div class="message-time">${currentTime}</div>
            </div>
        `;

      chatMessages.appendChild(messageDiv);
      messageDiv.scrollIntoView({
        behavior: "smooth",
        block: "start",
        inline: "nearest",
      });
    }

    function showTypingIndicator() {
      typingIndicator.style.display = "flex";
    }

    function hideTypingIndicator() {
      typingIndicator.style.display = "none";
    }

    // Function to get current form data from WACC form
    function getCurrentFormData() {
      const form = document.querySelector(".formWACC");
      if (!form) return null;

      const formData = {};

      // Get all form inputs
      const inputs = form.querySelectorAll("input, select, textarea");
      inputs.forEach((input) => {
        if (input.name && input.value) {
          formData[input.name] = input.value;
        }
      });

      return formData;
    }

    // Function to get current results data (if available)
    function getCurrentResultsData() {
      // Try to get data from Vue component if available
      if (window.AppFinanceWeb && window.AppFinanceWeb.modules.length > 0) {
        const module = window.AppFinanceWeb.modules.find(
          (m) => m.$el && m.$el.id === "AppResultKapitalWeb"
        );
        if (module) {
          return {
            emergent: module.emergent,
            developed: module.developed,
            company: module.company,
            template: module.template,
            typeId: module.typeId,
          };
        }
      }
      return null;
    }

    async function callGeminiAPI(userMessage) {
      try {
        if (
          !GEMINI_API_KEY ||
          GEMINI_API_KEY === "" ||
          GEMINI_API_KEY === "undefined"
        ) {
          handleAPIError("API key no configurada. Contacta al administrador.");
          return;
        }

        if (!GEMINI_API_KEY.startsWith("AIza")) {
          handleAPIError("Formato de API key inválido.");
          return;
        }

        // Get current form and results data
        const formData = getCurrentFormData();
        const resultsData = getCurrentResultsData();
        const currentPage = window.location.pathname;

        // Prepare the specialized beta analysis prompt
        const systemPrompt = `Eres un asistente especializado en análisis de BETA FINANCIERO para cálculos WACC en la plataforma Kapitals. Tu misión es generar una lista de tickers de empresas comparables y luego usar el sistema de análisis automático para obtener datos EXACTOS de Yahoo Finance.

METODOLOGÍA DE TRABAJO:
1. Cuando el usuario solicite análisis, genera una lista de 15-20 tickers de empresas del mismo sector
2. Los tickers deben ser EXACTAMENTE como aparecen en Yahoo Finance (ej: AAPL, MSFT, GOOGL)
3. Para empresas no-US, incluye el sufijo correcto (ej: .TO para Toronto, .L para Londres)
4. El sistema automáticamente extraerá datos reales de Yahoo Finance
5. Presenta los resultados calculados y recomienda un beta optimizado

DATOS ACTUALES DEL USUARIO:
${
  formData
    ? `
FORMULARIO WACC:
- Fecha: ${formData.date || "No especificado"}
- Industria/Sector: ${formData.sector || "No especificado"}
- País: ${formData.country || "No especificado"}
- Tasa libre de riesgo: ${formData.instrument || "No especificado"}
- Año del bono: ${formData.bono || "No especificado"}
- Devaluación: ${formData.devaluation || "No especificado"}%
- Tasa impositiva: ${formData.tax || "No especificado"}%
- Tipo de análisis: ${formData.typeId === "2" ? "Empresa específica" : "Análisis sectorial"}
${
  formData.typeId === "2"
    ? `
DATOS DE LA EMPRESA:
- Moneda: ${formData.currency || "No especificado"}
- Costo de deuda (Kd): ${formData.kd || "No especificado"}%
- Porcentaje de deuda: ${formData.debt || "No especificado"}%
- Porcentaje de capital: ${formData.capital || "No especificado"}%`
    : ""
}`
    : "No hay datos del formulario"
}

${
