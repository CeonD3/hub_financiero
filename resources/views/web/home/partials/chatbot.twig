    ? `
RESULTADOS ACTUALES:
- Tipo de análisis: ${resultsData.typeId === 1 ? "Sectorial" : "Empresa específica"}
- WACC Emergentes: ${resultsData.emergent?.cppc || "N/A"}%
- WACC Desarrollados: ${resultsData.developed?.cppc || "N/A"}%
${resultsData.typeId === 2 ? `- WACC Empresa: ${resultsData.company?.pen?.cppc || resultsData.company?.usd?.cppc || "N/A"}%` : ""}`
    : "No hay resultados disponibles"
}

Página actual: ${currentPage}

FORMATO DE RESPUESTA OBLIGATORIO:

=== ANÁLISIS DE BETA PARA [SECTOR] ===

Análisis automatizado solicitado para empresas comparables del sector [SECTOR_NAME].

TICKERS:[TICKER1,TICKER2,TICKER3,TICKER4,TICKER5,TICKER6,TICKER7,TICKER8,TICKER9,TICKER10,TICKER11,TICKER12,TICKER13,TICKER14,TICKER15,TICKER16,TICKER17,TICKER18,TICKER19,TICKER20]

[Explicación breve del sector y criterios de selección]

INSTRUCCIONES CRÍTICAS:
- SIEMPRE incluye "TICKERS:[lista_de_tickers]" en tu respuesta
- Los tickers deben estar separados por comas SIN ESPACIOS
- Ejemplo: TICKERS:[AAPL,MSFT,GOOGL,AMZN,TSLA]
- Usa tickers EXACTOS de Yahoo Finance
- Para empresas internacionales usa sufijos (.TO, .L, .PA, etc.)
- NO inventes tickers - usa solo empresas reales que conozcas que existen en Yahoo Finance

El sistema automáticamente:
1. Extraerá datos reales de Yahoo Finance para cada ticker
2. Calculará D/C ratio, tasa impositiva efectiva y betas
3. Generará recomendaciones de beta optimizado
4. Te presentará los resultados para que el usuario pueda elegir

REGLAS CRÍTICAS:
- SIEMPRE incluye "TICKERS:[lista]" en formato exacto
- Máximo 20 tickers por análisis
- Enfócate en empresas del MISMO SECTOR/INDUSTRIA
- Explica brevemente por qué seleccionaste esas empresas`;

        const contents = [];

        if (conversationHistory.length === 0) {
          contents.push({
            role: "user",
            parts: [{ text: systemPrompt }],
          });
          contents.push({
            role: "model",
            parts: [
              {
                text: "Perfecto. Soy tu asistente especializado en análisis de beta para WACC. Puedo analizar tu sector, recomendar empresas comparables y optimizar tu beta. ¿Quieres que analice tus datos actuales?",
              },
            ],
          });
        }

        conversationHistory.forEach((msg) => {
          contents.push(msg);
        });

        contents.push({
          role: "user",
          parts: [{ text: userMessage }],
        });

        const requestBody = {
          contents: contents,
          generationConfig: {
            temperature: 0.2, // Lower for more precise financial data
            maxOutputTokens: 8192,
            topP: 0.8,
            topK: 40,
          },
        };

        const response = await fetch(
          `${GEMINI_API_URL}?key=${GEMINI_API_KEY}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(requestBody),
          }
        );

        if (!response.ok) {
          const errorData = await response.text();
          throw new Error(`API request failed: ${response.status}`);
        }

        const data = await response.json();

        if (
          data.candidates &&
          data.candidates[0] &&
          data.candidates[0].content
        ) {
          let rawResponse = data.candidates[0].content.parts[0].text;

          // Check if response contains tickers for analysis
          const tickersMatch = rawResponse.match(/TICKERS:\[([^\]]+)\]/i);
          if (tickersMatch) {
            const tickersString = tickersMatch[1];
            const tickers = tickersString
              .split(",")
              .map((t) => t.trim())
              .filter((t) => t.length > 0);

            if (tickers.length > 0) {
              // Remove the TICKERS line from display
              const displayResponse = rawResponse
                .replace(/TICKERS:\[([^\]]+)\]/i, "")
                .trim();

              // Show the AI response first
              const aiResponse = formatAPIResponse(displayResponse);
              addMessage(aiResponse, "ai");

              // Then analyze the tickers
              analyzeYahooFinanceTickers(tickers);
            } else {
              const aiResponse = formatAPIResponse(rawResponse);
              addMessage(aiResponse, "ai");
            }
          } else {
            // Check if response contains beta update
            const betaUpdateMatch = rawResponse.match(
              /BETA_UPDATE:\s*([\d.]+)/i
            );
            if (betaUpdateMatch) {
              const newBeta = parseFloat(betaUpdateMatch[1]);
              // Remove the BETA_UPDATE line from display
              rawResponse = rawResponse
                .replace(/BETA_UPDATE:\s*[\d.]+/i, "")
                .trim();
              showBetaUpdateButton(rawResponse, newBeta);
            } else {
              const aiResponse = formatAPIResponse(rawResponse);
              addMessage(aiResponse, "ai");
            }
          }

          conversationHistory.push({
            role: "user",
            parts: [{ text: userMessage }],
          });
          conversationHistory.push({
            role: "model",
            parts: [{ text: rawResponse }],
          });

          hideTypingIndicator();
          setLoadingState(false);
        } else {
          throw new Error("Invalid response format");
        }
      } catch (error) {
        handleAPIError(error.message);
      }
    }

    // Function to analyze tickers using Yahoo Finance endpoint
    async function analyzeYahooFinanceTickers(tickers) {
      try {
        addMessage("🔍 Analizando empresas en Yahoo Finance...", "ai");
        showTypingIndicator();

        const response = await fetch("/api/analyze-companies", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            tickers: tickers,
          }),
        });

        if (!response.ok) {
          throw new Error(`Error ${response.status}: ${response.statusText}`);
        }

        const data = await response.json();

        hideTypingIndicator();

        if (
          data.success &&
          data.valid_companies &&
          data.valid_companies.length > 0
        ) {
          displayYahooFinanceResults(data);
        } else {
          addMessage(
            "⚠️ No se pudieron obtener datos válidos de Yahoo Finance para los tickers proporcionados.",
            "ai"
          );
        }
      } catch (error) {
        hideTypingIndicator();
        addMessage(`❌ Error analizando empresas: ${error.message}`, "ai");
      }
    }

    // Function to display Yahoo Finance analysis results
    function displayYahooFinanceResults(data) {
      const validCompanies = data.valid_companies;
      const stats = data.group_statistics;

      let resultHtml = `
        <div class="yahoo-finance-results">
          <div class="results-header">
            <h5><i class="fas fa-chart-line me-2"></i>Análisis Yahoo Finance Completado</h5>
          </div>
      `;
      // Individual companies
      resultHtml += `
        <div class="companies-detail">
          <h6><i class="fas fa-building me-2"></i>Empresas Analizadas</h6>
          <div class="companies-list">
      `;

      validCompanies.forEach((company, index) => {
        const dcRatioPercent = company.dc_ratio
          ? (company.dc_ratio * 100).toFixed(1)
          : "N/A";
        const taxRatePercent = company.effective_tax_rate
          ? (company.effective_tax_rate * 100).toFixed(1)
          : "N/A";

        resultHtml += `
          <div class="company-card company-clickable" data-company-index="${index}">
            <div class="company-header">
              <span class="company-name">${company.company_name}</span>
              <span class="company-ticker">${company.ticker}</span>
            </div>
            <div class="company-details">
              <small class="company-location">${company.country} | ${company.sector}</small>
            </div>
            <div class="financial-data">
              <div class="data-row">
                <span>D/C Ratio:</span>
                <span class="value">${dcRatioPercent}%</span>
              </div>
              <div class="data-row">
                <span>Tasa Impositiva:</span>
                <span class="value">${taxRatePercent}%</span>
              </div>
              <div class="data-row">
                <span>Beta Apalancado:</span>
                <span class="value">${company.beta_levered || "N/A"}</span>
              </div>
              <div class="data-row highlight">
                <span>Beta Desapalancado:</span>
                <span class="value">${company.beta_unlevered || "N/A"}</span>
              </div>
            </div>
            <div class="click-hint">
              <i class="fas fa-mouse-pointer me-1"></i>
              <small>Haz clic para usar estos datos</small>
            </div>
          </div>
        `;
      });

      resultHtml += `
          </div>
        </div>
      `;

      resultHtml += `</div>`;

      // Create message with results
      const messageDiv = document.createElement("div");
      messageDiv.className = "message ai-message";

      const currentTime = new Date().toLocaleTimeString("es-ES", {
        hour: "2-digit",
        minute: "2-digit",
      });

      messageDiv.innerHTML = `
        <div class="message-avatar bg-primary">
            <i class="fas fa-robot text-white"></i>
        </div>
        <div class="message-content">
            <div class="message-bubble">${resultHtml}</div>
            <div class="message-time">${currentTime}</div>
        </div>
      `;

      chatMessages.appendChild(messageDiv);

      // Add event listeners to company cards after they're in the DOM
      const companyCards = messageDiv.querySelectorAll(".company-clickable");
      companyCards.forEach((card) => {
        const companyIndex = parseInt(card.getAttribute("data-company-index"));
        const company = validCompanies[companyIndex];

        card.addEventListener("click", function () {
          console.log("Company card clicked:", company);
          applyCompanyData(company.ticker, company);
        });
      });

      messageDiv.scrollIntoView({
        behavior: "smooth",
        block: "start",
        inline: "nearest",
      });
    }

    // Function to apply recommended beta
    window.applyRecommendedBeta = function (betaValue, type) {
      updateBetaValue(betaValue);
      addMessage(`✓ Beta ${type} de ${betaValue} aplicado exitosamente.`, "ai");
    };

    // Function to apply specific company data
    window.applyCompanyData = function (ticker, companyData) {
      console.log("=== DEBUGGING applyCompanyData ===");
      console.log("Ticker:", ticker);
      console.log("CompanyData type:", typeof companyData);
      console.log("CompanyData:", companyData);

      try {
        if (!companyData || typeof companyData !== "object") {
          throw new Error("Datos de empresa inválidos");
        }

        console.log("Financial data to apply:");
        console.log("- dc_ratio:", companyData.dc_ratio);
        console.log("- effective_tax_rate:", companyData.effective_tax_rate);
        console.log("- beta_levered:", companyData.beta_levered);
        console.log("- beta_unlevered:", companyData.beta_unlevered);

        updateFinancialData({
          dc_ratio: companyData.dc_ratio,
          effective_tax_rate: companyData.effective_tax_rate,
          beta_levered: companyData.beta_levered,
          beta_unlevered: companyData.beta_unlevered,
        });

        addMessage(
          `📊 Datos de ${companyData.company_name} (${ticker}) aplicados al formulario exitosamente.`,
          "ai"
        );
      } catch (error) {
        console.error("Error in applyCompanyData:", error);
        addMessage(
          `❌ Error aplicando datos de ${ticker}: ${error.message}`,
          "ai"
        );
      }
    };

    // Function to apply group financial data (average/median)
    window.applyGroupFinancialData = function (
      betaUnlevered,
      dcRatio,
      taxRate,
      type
    ) {
      updateFinancialData({
        dc_ratio: dcRatio,
        effective_tax_rate: taxRate,
        beta_levered: null, // Will be calculated based on other values
        beta_unlevered: betaUnlevered,
      });

      addMessage(
        `📈 Datos ${type} del grupo aplicados:
• Beta Desapalancado: ${betaUnlevered.toFixed(4)}
• D/C Ratio: ${(dcRatio * 100).toFixed(1)}%
• Tasa Impositiva: ${(taxRate * 100).toFixed(1)}%`,
        "ai"
      );
    };

    // Function to show beta update button
    function showBetaUpdateButton(responseText, newBeta) {
      const cleanResponse = formatAPIResponse(responseText);

      const updateButtonHtml = `
        <div class="beta-update-section">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <div class="beta-value">Nuevo Beta Sugerido: ${newBeta}</div>
              <small class="text-muted">Basado en empresas comparables del sector</small>
            </div>
            <button class="beta-update-btn" onclick="updateBetaValue(${newBeta})">
              Actualizar Beta
            </button>
          </div>
        </div>`;

      // Create message with response + button
      const messageDiv = document.createElement("div");
      messageDiv.className = "message ai-message";

      const currentTime = new Date().toLocaleTimeString("es-ES", {
        hour: "2-digit",
        minute: "2-digit",
      });

      messageDiv.innerHTML = `
        <div class="message-avatar bg-primary">
            <i class="fas fa-robot text-white"></i>
        </div>
        <div class="message-content">
            <div class="message-bubble">${cleanResponse}${updateButtonHtml}</div>
            <div class="message-time">${currentTime}</div>
        </div>
      `;

      chatMessages.appendChild(messageDiv);
      messageDiv.scrollIntoView({
        behavior: "smooth",
        block: "start",
        inline: "nearest",
      });

      hideTypingIndicator();
      setLoadingState(false);
    }

    // Global function to update beta value and financial data
    window.updateBetaValue = function (newBeta) {
      // First, try to find any input that might contain beta value
      const possibleBetaInputs = [
        'input[name="beta"]',
        "#betaInput",
        'input[name*="beta" i]',
        'input[placeholder*="beta" i]',
        'input[name="beta_unlevered"]',
        'input[name="beta_levered"]',
      ];

      let betaInput = null;
      for (const selector of possibleBetaInputs) {
        betaInput = document.querySelector(selector);
        if (betaInput) break;
      }

      const form = document.querySelector(".formWACC");
      const typeIdInput = document.querySelector('input[name="typeId"]');
      const isCompanyAnalysis = typeIdInput && typeIdInput.checked;

      if (betaInput) {
        // Direct beta input found
        betaInput.value = newBeta;
        betaInput.dispatchEvent(new Event("change", { bubbles: true }));
        addMessage(`✓ Beta actualizado a ${newBeta} exitosamente.`, "ai");
      } else if (isCompanyAnalysis) {
        // For company analysis, beta is typically calculated from other inputs
        addMessage(
          `Para análisis de empresa específica, el beta se calcula automáticamente. El valor sugerido ${newBeta} puede usarse como referencia para ajustar otros parámetros.`,
          "ai"
        );
      } else {
        // For sector analysis, beta is usually predefined
        addMessage(
          `Para análisis sectorial, el beta ${newBeta} se aplicará en los cálculos internos. Puedes usar este valor como referencia o contactar soporte para implementación específica.`,
          "ai"
        );
      }

      // Suggest recalculation
      setTimeout(() => {
        const submitBtn = form?.querySelector('button[type="submit"]');
        if (submitBtn) {
          addMessage(
            '💡 Recomendación: Haz clic en "CALCULA TU WACC" para ver los resultados con el nuevo beta.',
            "ai"
          );
        }
      }, 1500);
    };

    // Function to update financial data from AI recommendations
    window.updateFinancialData = function (financialData) {
      console.log("=== DEBUGGING updateFinancialData ===");
      console.log("Financial data received:", financialData);

      // Activate the financial data section if not already active
      const financialDataToggle = document.getElementById(
        "financialDataToggle"
      );
      const collapseFinancialData = document.getElementById(
        "collapseFinancialData"
      );
      const toggleIcon = document.getElementById("collapseFaToggleFinancial");

      console.log("Form elements found:");
      console.log("- financialDataToggle:", financialDataToggle);
      console.log("- collapseFinancialData:", collapseFinancialData);
      console.log("- toggleIcon:", toggleIcon);

      if (!financialDataToggle.checked) {
        console.log("Activating financial data section...");
        financialDataToggle.checked = true;
        collapseFinancialData.classList.add("show");
        toggleIcon.classList.remove("fa-toggle-off");
        toggleIcon.classList.add("fa-toggle-on");
      } else {
        console.log("Financial data section already active");
      }

      // Update D/C ratio
      if (financialData.dc_ratio !== undefined) {
        const dcRatioInput = document.getElementById("dcRatioFormInput");
        console.log("Updating D/C ratio - Input found:", dcRatioInput);
        if (dcRatioInput) {
          const newValue = financialData.dc_ratio.toFixed(4);
          console.log("Setting D/C ratio value:", newValue);
          dcRatioInput.value = newValue;
          dcRatioInput.dispatchEvent(new Event("change", { bubbles: true }));
          console.log("D/C ratio updated. Current value:", dcRatioInput.value);
        }
      }

      // Update effective tax rate (convert from decimal to percentage)
      if (financialData.effective_tax_rate !== undefined) {
        const taxRateInput = document.getElementById(
          "effectiveTaxRateFormInput"
        );
        console.log("Updating tax rate - Input found:", taxRateInput);
        if (taxRateInput) {
          const newValue = (financialData.effective_tax_rate * 100).toFixed(2);
          console.log("Setting tax rate value:", newValue);
          taxRateInput.value = newValue;
          taxRateInput.dispatchEvent(new Event("change", { bubbles: true }));
          console.log("Tax rate updated. Current value:", taxRateInput.value);
        }
      }

      // Update beta levered
      if (financialData.beta_levered !== undefined) {
        const betaLeveredInput = document.getElementById(
          "betaLeveredFormInput"
        );
        console.log("Updating beta levered - Input found:", betaLeveredInput);
        if (betaLeveredInput) {
          const newValue = financialData.beta_levered.toFixed(4);
          console.log("Setting beta levered value:", newValue);
          betaLeveredInput.value = newValue;
          betaLeveredInput.dispatchEvent(
            new Event("change", { bubbles: true })
          );
          console.log(
            "Beta levered updated. Current value:",
            betaLeveredInput.value
          );
        }
      }

      // Update beta unlevered
      if (financialData.beta_unlevered !== undefined) {
        const betaUnleveredInput = document.getElementById(
          "betaUnleveredFormInput"
        );
        console.log(
          "Updating beta unlevered - Input found:",
          betaUnleveredInput
        );
        if (betaUnleveredInput) {
          const newValue = financialData.beta_unlevered.toFixed(4);
          console.log("Setting beta unlevered value:", newValue);
          betaUnleveredInput.value = newValue;
          betaUnleveredInput.dispatchEvent(
            new Event("change", { bubbles: true })
          );
          console.log(
            "Beta unlevered updated. Current value:",
            betaUnleveredInput.value
          );
        }
      }

      console.log("=== END updateFinancialData ===");

      // Show success message
      addMessage(
        `✅ Datos financieros actualizados automáticamente:
• D/C Ratio: ${(financialData.dc_ratio * 100).toFixed(1)}%
• Tasa Impositiva: ${(financialData.effective_tax_rate * 100).toFixed(1)}%
• Beta Apalancado: ${financialData.beta_levered?.toFixed(4) || "N/A"}
• Beta Desapalancado: ${financialData.beta_unlevered?.toFixed(4) || "N/A"}`,
        "ai"
      );

      // Scroll to the financial data section
      setTimeout(() => {
        collapseFinancialData.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }, 500);
    };

    function handleAPIError(errorMessage) {
      hideTypingIndicator();
      setLoadingState(false);

      const fallbackResponses = [
        "Disculpa, tengo problemas técnicos. Mientras tanto, puedes usar betas de referencia: Tecnología (1.2-1.5), Servicios Financieros (1.1-1.3), Retail (0.9-1.2), Utilities (0.6-0.8).",
        "No puedo acceder a la base de datos ahora. Para tu sector, considera betas entre 0.8-1.5 según la industria. ¿Necesitas ayuda con algún cálculo específico?",
      ];

      const response =
        fallbackResponses[Math.floor(Math.random() * fallbackResponses.length)];
      addMessage(response, "ai");
    }

    // Close chatbot when clicking outside
    document.addEventListener("click", function (e) {
      if (
        isOpen &&
        !chatbotToggle.contains(e.target) &&
        !chatbotWindow.contains(e.target)
      ) {
        isOpen = false;
        chatbotWindow.style.display = "none";
      }
    });
  });
</script>
