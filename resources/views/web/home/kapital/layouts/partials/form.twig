<form class="formWACC" id="{{ data.uid }}">
    <div class="card shadow-none mb-5">
        <div class="card-header px-2">
            <div class="card-title">
                <span class="badge bg-primary rounded-pill me-1 fs-3 px-3">1</span>
                <div class="ms-2 me-auto">
                    <div class="fw-bold">
                        Ingrese inputs de la industria
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body px-2 pb-0">
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">Fecha</label>
                <div class="col-lg-8">
                    <select class="form-select" data-control="select2" name="date" data-placeholder="SELECCIONE" id="dateFormInput" required>
                        <option></option>
                        {% for item in data.form.dates %}
                        <option value="{{ item }}" {{ data.form.date == item ? 'selected' : '' }}>{{ item }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">Industria</label>
                <div class="col-lg-8">
                    <select class="form-select" name="sector" data-control="select2" data-placeholder="SELECCIONE" required>
                        <option></option>
                        {% for item in data.form.sectors %}
                        <option value="{{ item }}" {{ data.form.sector == item ? 'selected' : '' }}>{{ item }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">Tasa libre de riesgo</label>
                <div class="col-lg-8">
                    <select class="form-select" name="instrument" data-control="select2" data-placeholder="SELECCIONE"  required>
                        <option></option>
                        {% for item in data.form.instruments %}
                        <option value="{{ item }}" {{ data.form.instrument == item ? 'selected' : '' }}>{{ item }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">Año del bono</label>
                <div class="col-lg-8">
                    <select class="form-select" name="bono" data-control="select2" data-placeholder="SELECCIONE" required>
                        <option></option>
                        {% for item in data.form.bonos %}
                        <option value="{{ item }}" {{ data.form.bono == item ? 'selected' : '' }}>{{ item }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
        <div class="card-header px-2 mt-2">
            <div class="card-title">
                <span class="badge bg-primary rounded-pill me-1 fs-3 px-3">2</span>
                <div class="ms-2 me-auto">
                    <div class="fw-bold">
                        Ingrese inputs del sector
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body px-2 pb-0">
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">País</label>
                <div class="col-lg-8">
                    <select class="form-select" name="country" data-control="select2" data-placeholder="SELECCIONE" id="countryFormInput" required>
                        <option></option>
                        {% for item in data.form.countries %}
                        <option value="{{ item }}" {{ data.form.country == item ? 'selected' : '' }}>{{ item }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">Devaluación</label>
                <div class="col-lg-8">
                    <div class="input-group">
                        <input type="text" class="form-control" name="devaluation" value="{{ data.form.devaluation }}" id="devaluationFormInput">
                        <span class="input-group-text">%</span>
                    </div>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">Tasa impositiva</label>
                <div class="col-lg-8">
                    <div class="input-group">
                        <input type="text" class="form-control" name="tax" value="{{ data.form.tax }}" id="taxFormInput">
                        <span class="input-group-text">%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-header px-2 mt-5">
            <div class="card-title">
                <span class="badge bg-primary rounded-pill me-1 fs-3 px-3">3</span>
                <div class="ms-2 me-auto lh-1">
                    <div class="fw-bold">
                        Ingrese inputs de su empresa
                        <label class="float-end ms-2 {{ data.template.type_id == 2 ? '' : 'collapsed' }}" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="{{ data.template.type_id == 2 ? 'true' : 'false' }}" aria-controls="collapseExample" onclick="collapseFaToggle(this, 'collapseFaToggle')" for="typeform">
                            <i class="fa-solid {{ data.template.type_id == 2 ? 'fa-toggle-on' : 'fa-toggle-off' }} fs-2 text-dark" id="collapseFaToggle"></i>
                        </label>
                    </div>
                    <small>En caso no posea estos datos puede eliminarlos</small>
                </div>
                <input class="d-none" type="checkbox" id="typeform" name="typeId" value="2" {{ data.template.type_id == 2 ? 'checked' : '' }}>
            </div>
        </div>
        <div class="card-body px-2 pb-0 collapse {{ data.template.type_id == 2 ? 'show' : '' }}" id="collapseExample">
            <div class="mb-3 row">
                <label class="col-lg-12 col-form-label">Costo de deuda</label>
                <div class="col-lg-12">
                    <div class="input-group">
                        <select class="input-group-text" name="currency" id="" style="width:120px;">
                            {% for item in data.form.currencies %}
                            <option value="{{ item }}" {{ data.form.currency == item ? 'selected' : '' }}>{{ item }}</option>
                            {% endfor %}
                        </select>
                        <input type="text" class="form-control companyInput" name="kd" placeholder="Escriba su Kd" value="{{ data.form.ekd }}" {{ data.template.type_id == 2 ? 'required' : '' }}>
                        <span class="input-group-text">%</span>
                    </div>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">Porcentaje de deuda</label>
                <div class="col-lg-8">
                    <div class="input-group">
                        <input type="text" class="form-control companyInput" name="debt" placeholder="" value="{{ data.form.epd }}" {{ data.template.type_id == 2 ? 'required' : '' }} id="pdFormInput">
                        <span class="input-group-text" id="basic-addon2">%</span>
                    </div>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">Porcentaje de capital</label>
                <div class="col-lg-8">
                    <div class="input-group">
                        <input type="text" class="form-control companyInput" name="capital" placeholder="" value="{{ data.form.epc }}" {{ data.template.type_id == 2 ? 'required' : '' }} id="pcFormInput" readonly>
                        <span class="input-group-text" id="basic-addon2">%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-header px-2 mt-5">
            <div class="card-title">
                <span class="badge bg-primary rounded-pill me-1 fs-3 px-3">4</span>
                <div class="ms-2 me-auto lh-1">
                    <div class="fw-bold">
                        Datos financieros optimizados
                        <label class="float-end ms-2 {{ data.form.useFinancialData == '1' ? '' : 'collapsed' }}" data-bs-toggle="collapse" href="#collapseFinancialData" role="button" aria-expanded="{{ data.form.useFinancialData == '1' ? 'true' : 'false' }}" aria-controls="collapseFinancialData" onclick="collapseFaToggle(this, 'collapseFaToggleFinancial')" for="financialDataToggle">
                            <i class="fa-solid {{ data.form.useFinancialData == '1' ? 'fa-toggle-on' : 'fa-toggle-off' }} fs-2 text-dark" id="collapseFaToggleFinancial"></i>
                        </label>
                    </div>
                    <small>Datos que pueden ser completados automáticamente por el asistente IA</small>
                </div>
                <input class="d-none" type="checkbox" id="financialDataToggle" name="useFinancialData" value="1" {{ data.form.useFinancialData == '1' ? 'checked' : '' }}>
            </div>
        </div>
        <div class="card-body px-2 pb-0 collapse {{ data.form.useFinancialData == '1' ? 'show' : '' }}" id="collapseFinancialData">
            <div class="alert alert-info d-flex align-items-center mb-3">
                <i class="fas fa-info-circle me-2"></i>
                <div>
                    <strong>Sugerencia:</strong> Use el chatbot de análisis financiero para obtener estos datos automáticamente basados en empresas comparables del sector.
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">
                    D/C Ratio
                    <i class="fas fa-info-circle ms-1" data-bs-toggle="tooltip" title="Ratio Deuda/Capital: Proporción de deuda respecto al capital total"></i>
                </label>
                <div class="col-lg-8">
                    <div class="input-group">
                        <input type="text" class="form-control financialInput" name="dc_ratio" placeholder="Ej: 0.35" value="{{ data.form.dc_ratio ?? '' }}" id="dcRatioFormInput">
                        <span class="input-group-text">decimal</span>
                    </div>
                    <div class="form-text">Ingrese como decimal (ej: 0.35 para 35%)</div>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">
                    Tasa Efectiva de Impuesto
                    <i class="fas fa-info-circle ms-1" data-bs-toggle="tooltip" title="Tasa real de impuestos que paga la empresa"></i>
                </label>
                <div class="col-lg-8">
                    <div class="input-group">
                        <input type="text" class="form-control financialInput" name="effective_tax_rate" placeholder="Ej: 25.5" value="{{ data.form.effective_tax_rate ?? '' }}" id="effectiveTaxRateFormInput">
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">Tasa efectiva real de impuestos de la empresa</div>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">
                    Beta Apalancado
                    <i class="fas fa-info-circle ms-1" data-bs-toggle="tooltip" title="Beta que incluye el riesgo financiero de la estructura de capital"></i>
                </label>
                <div class="col-lg-8">
                    <div class="input-group">
                        <input type="text" class="form-control financialInput" name="beta_levered" placeholder="Ej: 1.25" value="{{ data.form.beta_levered ?? '' }}" id="betaLeveredFormInput">
                        <span class="input-group-text">coef.</span>
                    </div>
                    <div class="form-text">Beta que refleja el riesgo financiero y operativo</div>
                </div>
            </div>
            <div class="mb-3 row">
                <label class="col-lg-4 col-form-label">
                    Beta Desapalancado
                    <i class="fas fa-info-circle ms-1" data-bs-toggle="tooltip" title="Beta que refleja solo el riesgo operativo, sin apalancamiento financiero"></i>
                </label>
                <div class="col-lg-8">
                    <div class="input-group">
                        <input type="text" class="form-control financialInput" name="beta_unlevered" placeholder="Ej: 0.95" value="{{ data.form.beta_unlevered ?? '' }}" id="betaUnleveredFormInput">
                        <span class="input-group-text">coef.</span>
                    </div>
                    <div class="form-text">Beta sin riesgo financiero, solo riesgo del negocio</div>
                </div>
            </div>
        </div>
        <div class="card-footer px-2 pb-0">
            <button type="submit" class="btn btn-primary w-100">CALCULA TU WACC</button>
        </div>
        {# {% if data.uid %}
        <div class="mt-5 text-center">
            <a href="{{ APP.API_URL_FINANCE }}/template/users/{{ data.template.file }}" download>Plantilla Generada</a>
        </div>
        {% endif %} #}
    </div>
</form>

<!-- Initialize tooltips for financial data fields -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Bootstrap tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });
    
    // Add collapseFaToggle function for financial data section
    window.collapseFaToggle = function(element, iconId) {
        const icon = document.getElementById(iconId);
        if (icon) {
            if (icon.classList.contains('fa-toggle-off')) {
                icon.classList.remove('fa-toggle-off');
                icon.classList.add('fa-toggle-on');
            } else {
                icon.classList.remove('fa-toggle-on');
                icon.classList.add('fa-toggle-off');
            }
        }
    };
});
</script>
